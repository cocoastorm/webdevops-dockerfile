{{ docker.fromOfficial("alpine") }}

ARG TARGETARCH
ARG GOREPLACE_ARCH=${TARGETARCH}
ARG GOSU_ARCH=${TARGETARCH}

RUN apk add --no-cache \
        ca-certificates \
        openssl \
        curl \
        bash \
        sed \
        wget \
        zip \
        unzip \
        bzip2 \
        p7zip \
        drill \
        ldns \
        openssh-client \
        rsync \
        git \
        gnupg \
    && mkdir -p \
        /baselayout/sbin \
        /baselayout/usr/local/bin \
        # Baselayout scripts
        && wget -O /tmp/baselayout-install.sh https://raw.githubusercontent.com/webdevops/Docker-Image-Baselayout/master/install.sh \
        && sh /tmp/baselayout-install.sh /baselayout \
        {{ tools.goreplace(path="/baselayout/usr/local/bin", arch="${GOREPLACE_ARCH}") }} \
        && ln -s /baselayout/usr/local/bin/go-replace /usr/local/bin/ \
        {{ tools.gosu(path="/baselayout/sbin", arch="${GOSU_ARCH}") }}
